///|
/// A single AI-generated test case.
pub(all) struct GeneratedTest {
  name : String
  description : String
  test_code : String
  test_type : String
}

///|
/// A suite of AI-generated tests for a module.
pub(all) struct GeneratedTestSuite {
  module_name : String
  tests : Array[GeneratedTest]
}

///|
/// Generate a mock test for a symbol (baseline without LLM).
fn generate_mock_test(symbol : @lib.ApiSymbol) -> GeneratedTest {
  let test_name = "test_" + symbol.name
  let description = "Basic test for \{symbol.kind} \{symbol.name}"
  let code = StringBuilder()
  code.write_string("test \"")
  code.write_string(test_name)
  code.write_string("\" {\n")
  code.write_string("  // Test for \{symbol.kind} \{symbol.name}\n")
  code.write_string("  // Signature: \{symbol.signature}\n")
  code.write_string("  // TODO: Implement test assertions\n")
  code.write_string("  assert_true(true)\n")
  code.write_string("}\n")
  let test_type = match symbol.kind {
    "fn" => "unit"
    "struct" => "construction"
    "enum" => "pattern-match"
    "type" => "type-alias"
    _ => "basic"
  }
  { name: test_name, description, test_code: code.to_string(), test_type }
}

///|
/// Generate test cases for all symbols in an API reference.
pub fn generate_symbol_tests(
  _config : AiConfig,
  api_ref : @lib.ApiReference,
) -> GeneratedTestSuite {
  let tests : Array[GeneratedTest] = []
  for symbol in api_ref.symbols {
    tests.push(generate_mock_test(symbol))
  }
  { module_name: api_ref.package_name, tests }
}

///|
/// Convert a generated test suite to MoonBit test code.
pub fn tests_to_moonbit(suite : GeneratedTestSuite) -> String {
  let out = StringBuilder()
  out.write_string("// AI-generated tests for module: ")
  out.write_string(suite.module_name)
  out.write_string("\n// Generated by MoonDocKit AI Test Generator\n\n")
  for t in suite.tests {
    out.write_string("// ")
    out.write_string(t.description)
    out.write_string("\n")
    out.write_string(t.test_code)
    out.write_string("\n")
  }
  out.to_string()
}
